{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions granted to the Picvert window",
  "windows": ["main", "compact"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide",
    "dialog:default",
    "updater:default",
    "notification:default",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "engine",
          "cmd": "$RESOURCE/engine/picvert-engine",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "engine",
          "cmd": "$RESOURCE/engine/picvert-engine",
          "args": true
        }
      ]
    }
  ]
}
