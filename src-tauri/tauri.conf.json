{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Picvert",
  "version": "1.3.1",
  "identifier": "com.akxan.picvert",
  "build": {
    "frontendDist": "../ui",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Picvert",
        "width": 720,
        "height": 720,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "compact",
        "title": "Picvert",
        "url": "compact.html",
        "width": 280,
        "height": 140,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost https://ipwho.is https://ipapi.co https://api.open-meteo.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$PICTURE/**",
          "/Volumes/**",
          "/tmp/**",
          "/private/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/picvert-engine": "engine",
      "icons/tray.png": "icons/tray.png",
      "icons/tray@2x.png": "icons/tray@2x.png",
      "icons/tray-win.png": "icons/tray-win.png",
      "icons/tray-linux.png": "icons/tray-linux.png"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Akxan/picvert/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5OTZFQUMyNjE1MzQzRkEKUldUNlExTmh3dXFXS1lzemdJUEY1M2FWeUlYTXNXYjRLTFlLTkZabEc4a3pDSDBOY1ZTaGpqTlcK"
    }
  }
}
